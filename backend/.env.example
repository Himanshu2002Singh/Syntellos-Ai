# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration
# Supported DB_TYPE: "mysql" or "sqlite" (defaults to "mysql", auto-falls back to "sqlite" if MySQL is unreachable in development)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=syntellos_ai

# SQLite storage path (used when DB_TYPE=sqlite or MySQL fallback is triggered)
SQLITE_FILE=./data/syntellos.sqlite

# JWT Authentication
JWT_SECRET=syntellos_ai_super_secure_jwt_secret_key_2026!
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (used during auto-seed)
ADMIN_DEFAULT_NAME=Syntellos Admin
ADMIN_DEFAULT_EMAIL=admin@syntellosai.com
ADMIN_DEFAULT_PASSWORD=Admin@Syntellos2026

# SMTP / Email Trigger Service Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Syntellos AI" <no-reply@syntellosai.com>

# Notifications
ADMIN_NOTIFICATION_EMAIL=info@syntellosai.com
